---
import { whatsappLink } from '../config/site';
import Icon from './Icon.astro';
---
<a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Écrire à Jean sur WhatsApp">
  <Icon name="whatsapp" size={30} />
  <span class="wa-float__label">Une question ? <strong>WhatsApp</strong></span>
</a>

<div class="mobile-bar">
  <a class="btn" href="/contact/">Devis gratuit</a>
  <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
</div>

<style>
  .wa-float { position: fixed; right: 22px; bottom: 22px; z-index: 60; display: flex; align-items: center; gap: 12px; height: 62px; padding: 0 22px 0 16px; border-radius: 999px; background: var(--wa); color: #fff; text-decoration: none; box-shadow: 0 12px 30px rgba(31, 168, 85, .38); transition: transform .2s; }
  .wa-float:hover { transform: translateY(-2px) scale(1.02); }
  .wa-float__label { font-size: .92rem; line-height: 1.2; }
  .wa-float::before { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgba(31,168,85,.5); animation: wa-pulse 2.6s infinite; }
  @keyframes wa-pulse { 0% { box-shadow: 0 0 0 0 rgba(31,168,85,.45); } 70% { box-shadow: 0 0 0 16px rgba(31,168,85,0); } 100% { box-shadow: 0 0 0 0 rgba(31,168,85,0); } }
  .mobile-bar { display: none; }
  @media (max-width: 699px) {
    .wa-float { display: none; }
    .mobile-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgba(250,247,242,.96); backdrop-filter: blur(10px); border-top: 1px solid var(--line); }
    .mobile-bar .btn { min-height: 48px; padding: 0 12px; }
    /* Si l'hébergeur ajoute un badge flottant en bas de l'écran, la barre se place au-dessus */
    .mobile-bar.is-lifted { bottom: var(--lift, 64px); background: transparent; border-top: 0; backdrop-filter: none; padding-bottom: 6px; }
    .mobile-bar.is-lifted .btn { box-shadow: 0 8px 22px rgba(15, 42, 63, .22); }
  }
  @media (min-width: 700px) { .wa-float.is-lifted { bottom: calc(var(--lift, 64px) + 8px); } }
</style>

<script>
  // Détecte un élément fixe en bas d'écran ajouté par l'hébergeur (ex. badge Netlify)
  const ours = (el: Element) => el.matches('.mobile-bar, .wa-float, header, main, footer, script, style, a.skip-link');
  const check = () => {
    let lift = 0;
    for (const el of Array.from(document.body.children)) {
      if (ours(el)) continue;
      const nodes = [el, ...(el.shadowRoot ? Array.from(el.shadowRoot.children) : []), ...Array.from(el.querySelectorAll('*')).slice(0, 30)];
      for (const n of nodes) {
        const cs = getComputedStyle(n);
        if (cs.position !== 'fixed' || cs.display === 'none' || cs.visibility === 'hidden') continue;
        const r = n.getBoundingClientRect();
        if (r.height > 0 && r.height < 120 && window.innerHeight - r.bottom < 40) lift = Math.max(lift, window.innerHeight - r.top + 6);
      }
    }
    document.querySelectorAll<HTMLElement>('.mobile-bar, .wa-float').forEach((b) => {
      b.classList.toggle('is-lifted', lift > 0);
      if (lift) b.style.setProperty('--lift', `${Math.round(lift)}px`);
    });
  };
  window.addEventListener('load', () => { check(); setTimeout(check, 1500); setTimeout(check, 4000); });
  window.addEventListener('resize', check);
</script>
