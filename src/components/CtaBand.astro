---
import { whatsappLink } from '../config/site';
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; waText?: string }
const {
  title = 'Un devis précis, gratuit, sous 24 à 48 h.',
  text = 'Décrivez votre besoin en 2 minutes, ajoutez quelques photos : Jean vous recontacte rapidement.',
  waText,
} = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__in">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn" href="/contact/">Demander mon devis</a>
      <a class="btn btn--wa" href={whatsappLink(waText)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(40px, 6vw, 72px); }
  .cta-band__in { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; justify-content: space-between; background: var(--terra-soft); border-radius: var(--radius-lg); padding: clamp(28px, 4vw, 52px); }
  .cta-band h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: 8px; }
  .cta-band p { margin: 0; color: var(--ink-2); max-width: 52ch; }
  @media (max-width: 1000px) { .cta-band__in { margin-inline: 0; } }
</style>
