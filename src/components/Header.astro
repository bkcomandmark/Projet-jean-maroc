---
import { site, nav, whatsappLink } from '../config/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<header class="hdr" data-header>
  <div class="container hdr__in">
    <a href="/" class="logo" aria-label={`${site.name} — accueil`}>
      <span class="logo__mark" aria-hidden="true">J</span>
      <span class="logo__txt">
        <span class="logo__name">{site.name}</span>
        <span class="logo__sub">Finitions standard européen</span>
      </span>
    </a>

    <nav class="nav" id="main-nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="nav__extra"><a href="/zones-intervention/">Zones d’intervention</a></li>
        <li class="nav__extra"><a href="/contact/">Devis & contact</a></li>
      </ul>
      <div class="nav__mobile-cta">
        <a class="btn" href="/contact/">Demander un devis</a>
        <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </nav>

    <div class="hdr__actions">
      <a class="btn hdr__cta" href="/contact/">Devis gratuit</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Ouvrir le menu" data-burger>
        <span class="ico-open"><Icon name="menu" size={26} /></span>
        <span class="ico-close"><Icon name="close" size={26} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Le flou est porté par un pseudo-élément : sur Safari, un backdrop-filter sur l'en-tête
     enfermerait le menu mobile (position: fixed) dans la hauteur de l'en-tête. */
  .hdr { position: sticky; top: 0; z-index: 70; border-bottom: 1px solid transparent; transition: border-color .25s, box-shadow .25s; }
  .hdr::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(250, 247, 242, 0.9); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); }
  .hdr.is-scrolled { border-color: var(--line); box-shadow: 0 6px 24px rgba(15, 42, 63, .06); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 76px; }
  .logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .logo__mark { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--navy); color: #fff; font: italic 500 1.45rem/1 var(--serif); flex: none; }
  .logo__txt { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name { font: 500 1.28rem/1.1 var(--serif); letter-spacing: -.01em; white-space: nowrap; }
  .logo__sub { font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--terra); font-weight: 600; margin-top: 3px; white-space: nowrap; }

  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  .nav ul a { display: block; padding: 10px 12px; border-radius: 999px; text-decoration: none; font-size: .93rem; font-weight: 500; color: var(--ink-2); white-space: nowrap; transition: background .2s, color .2s; }
  .nav ul a:hover { background: var(--bg-2); color: var(--ink); }
  .nav ul a[aria-current='page'] { color: var(--terra); }
  .nav__mobile-cta, .nav__extra { display: none; }
  .hdr__actions { display: flex; align-items: center; gap: 10px; }
  .hdr__cta { min-height: 46px; padding: 0 22px; }
  .burger { display: none; background: none; border: 0; padding: 8px; margin-right: -8px; cursor: pointer; color: var(--ink); }
  .burger .ico-close { display: none; }
  .burger[aria-expanded='true'] .ico-open { display: none; }
  .burger[aria-expanded='true'] .ico-close { display: block; }

  @media (max-width: 1180px) {
    .burger { display: inline-flex; }
    .nav { position: fixed; top: 76px; left: 0; right: 0; height: calc(100dvh - 76px); background: var(--bg); padding: 8px var(--gutter) calc(96px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; overflow-y: auto; visibility: hidden; opacity: 0; transform: translateY(-8px); transition: opacity .25s ease, transform .25s ease, visibility 0s linear .25s; }
    .nav.is-open { visibility: visible; opacity: 1; transform: none; transition: opacity .25s ease, transform .25s ease; }
    .nav ul { flex-direction: column; gap: 0; }
    .nav ul a { font: 500 1.45rem/1.25 var(--serif); padding: 16px 0; border-radius: 0; border-bottom: 1px solid var(--line); color: var(--ink); white-space: normal; }
    .nav ul a:hover { background: none; color: var(--terra); }
    .nav__extra { display: block; }
    .nav__mobile-cta { display: grid; gap: 12px; margin-top: 28px; }
  }
  @media (max-width: 480px) { .hdr__cta { display: none; } .logo__sub { font-size: .6rem; letter-spacing: .1em; } .logo__name { font-size: 1.18rem; } }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const nav = document.getElementById('main-nav');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const setOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.documentElement.classList.toggle('menu-open', open);
  };
  burger?.addEventListener('click', () => setOpen(!nav?.classList.contains('is-open')));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  window.addEventListener('resize', () => { if (window.innerWidth > 1180) setOpen(false); });
</script>
