---
import { images, imgUrl, imgSrcset, type ImageKey } from '../data/images';
interface Props {
  name: ImageKey;
  /** ratio hauteur/largeur, ex. 0.66 */
  ratio?: number;
  sizes?: string;
  eager?: boolean;
  class?: string;
  alt?: string;
}
const { name, ratio = 0.7, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, class: cls, alt } = Astro.props;
const img = images[name];
const srcset = imgSrcset(name, [480, 800, 1200, 1800], ratio);
---
<img
  class={cls}
  src={imgUrl(name, 1200, Math.round(1200 * ratio))}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  width="1200"
  height={Math.round(1200 * ratio)}
  alt={alt ?? img.alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  style={img.pos ? `object-position: ${img.pos}` : undefined}
/>
