---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" noindex>
  <section class="section">
    <div class="container narrow center">
      <p class="eyebrow">Erreur 404</p>
      <h1>Cette page n’existe pas… <em class="accent">ou plus.</em></h1>
      <p class="lead">Contrairement à nos finitions, ce lien n’est pas parfait. Revenez à l’accueil ou découvrez nos prestations.</p>
      <div class="btn-row" style="justify-content:center;margin-top:28px">
        <a class="btn" href="/">Accueil</a>
        <a class="btn btn--ghost" href="/prestations/">Prestations</a>
      </div>
    </div>
  </section>
</Base>
