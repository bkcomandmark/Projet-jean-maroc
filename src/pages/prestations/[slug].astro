---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { zones, whatsappLink } from '../../config/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props as { service: Service };
const others = services.filter((o) => o.slug !== s.slug).slice(0, 6);
const pageUrl = new URL(`/prestations/${s.slug}/`, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title,
    description: s.metaDescription,
    provider: { '@id': new URL('/#entreprise', Astro.site).href },
    areaServed: zones.map((z) => z.name),
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Prestations', item: new URL('/prestations/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: s.title, item: pageUrl },
    ],
  },
  ...(s.faq.length
    ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---
<Base title={s.seoTitle} description={s.metaDescription} image={s.image} schema={schema}>
  <section class="page-hero">
    <div class="container split">
      <div>
        <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/prestations/">Prestations</a><span aria-hidden="true">/</span>{s.title}</nav>
        <p class="eyebrow">Prestation</p>
        <h1>{s.title}</h1>
        <p class="hook">{s.hook}</p>
        <p class="lead">{s.intro}</p>
        <div class="btn-row">
          <a class="btn" href={`/contact/?prestation=${s.slug}`}>Devis pour ce besoin</a>
          <a class="btn btn--ghost" href={whatsappLink(`Bonjour Jean, j'ai besoin d'un devis : ${s.title}.`)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>
      <div class="photo hero-img"><Picture name={s.image} ratio={0.9} eager /></div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--top">
      <div class="reveal">
        <p class="eyebrow">Ce qui est compris</p>
        <h2>Une prestation complète, de la préparation au nettoyage.</h2>
        <ul class="checklist">
          {s.includes.map((it) => <li>{it}</li>)}
        </ul>
      </div>
      <div class="diff reveal">
        <p class="eyebrow">La différence Jean</p>
        {s.difference.map((d) => (
          <div class="diff__item">
            <Icon name="check" size={22} />
            <div><h3>{d.title}</h3><p>{d.text}</p></div>
          </div>
        ))}
        <p class="diff__note">Devis gratuit et détaillé · Intervention à {zones.map((z) => z.name).join(', ')}.</p>
      </div>
    </div>
  </section>

  {s.faq.length > 0 && (
    <section class="section section--alt">
      <div class="container narrow">
        <h2 class="center">Questions fréquentes</h2>
        <div class="faq">
          {s.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>
  )}

  <CtaBand waText={`Bonjour Jean, j'ai besoin d'un devis : ${s.title}.`} />

  <section class="section section--tight">
    <div class="container">
      <h2>Les autres savoir-faire de Jean</h2>
      <ul class="others">
        {others.map((o) => (
          <li><a href={`/prestations/${o.slug}/`}><Icon name={o.icon} size={22} /><span>{o.title}</span></a></li>
        ))}
        <li><a href="/prestations/"><Icon name="arrow" size={22} /><span>Toutes les prestations</span></a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hook { font: italic 400 1.3rem/1.4 var(--serif); color: var(--terra); }
  .page-hero .lead { margin-bottom: 30px; }
  .hero-img { aspect-ratio: 1 / 0.95; }
  .split--top { align-items: start; }
  .diff { background: var(--navy); color: #c3ced8; border-radius: var(--radius-lg); padding: clamp(26px, 3.5vw, 40px); }
  .diff .eyebrow { color: #e5a27f; }
  .diff__item { display: flex; gap: 16px; padding-block: 16px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .diff__item :global(svg) { color: #e5a27f; flex: none; margin-top: 3px; }
  .diff h3 { color: #fff; font-size: 1.15rem; margin-bottom: 4px; }
  .diff p { margin: 0; }
  .diff__note { margin-top: 20px !important; font-size: .88rem; color: #8fa3b5; }
  .others { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .others a { display: flex; align-items: center; gap: 12px; padding: 16px 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; font-weight: 500; transition: border-color .2s, color .2s; }
  .others a:hover { border-color: var(--terra); color: var(--terra); }
  .others :global(svg) { color: var(--terra); flex: none; }
</style>
