---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../config/site';
import { imgUrl, type ImageKey } from '../../data/images';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const img = post.data.image as ImageKey;
const fmt = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/blog/${post.id}/`, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: imgUrl(img, 1200),
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    author: { '@type': 'Person', name: site.founder },
    publisher: { '@id': new URL('/#entreprise', Astro.site).href },
    mainEntityOfPage: url,
    inLanguage: 'fr-FR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Conseils', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base title={post.data.title} description={post.data.description} image={img} type="article" schema={schema}>
  <article>
    <header class="page-hero art-hero">
      <div class="container narrow">
        <nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/blog/">Conseils</a></nav>
        <span class="pill">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <p class="meta">Par {site.founder} · <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
      </div>
    </header>
    <div class="container narrow">
      <div class="photo art-img"><Picture name={img} ratio={0.55} eager sizes="(min-width: 800px) 780px, 100vw" /></div>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <CtaBand />
</Base>

<style>
  .art-hero { border-bottom: 0; padding-bottom: 32px; }
  .art-hero h1 { font-size: clamp(2rem, 4.4vw, 3.2rem); margin-top: 16px; }
  .meta { color: var(--muted); font-size: .9rem; }
  .art-img { aspect-ratio: 16 / 9; margin-bottom: 40px; }
  .prose { padding-bottom: 32px; }
</style>
