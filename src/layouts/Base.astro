---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site, zones } from '../config/site';
import { imgUrl, type ImageKey } from '../data/images';

interface Props {
  title: string;
  description?: string;
  image?: ImageKey;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Données structurées additionnelles (JSON-LD) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, image = 'jean-og', type = 'website', noindex = false, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const ogImage = new URL(imgUrl(image, 1200, 630), Astro.site).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': new URL('/#entreprise', Astro.site).href,
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  image: new URL(imgUrl('jean-og'), Astro.site).href,
  telephone: site.phoneMaroc,
  email: site.email,
  priceRange: 'Sur devis',
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: 'Tanger-Tétouan-Al Hoceïma', addressCountry: 'MA' },
  areaServed: zones.map((z) => ({ '@type': 'City', name: z.name })),
  founder: { '@type': 'Person', name: site.founder },
  knowsLanguage: 'fr',
  openingHours: 'Mo-Sa 08:00-19:00',
};
const schemas = [business, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0f2a3f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Conseils`} href="/rss.xml" />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
